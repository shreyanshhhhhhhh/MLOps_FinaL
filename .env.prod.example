# Copy to /opt/priceoptima/.env.prod on the EC2 host and chmod 600.
# Do not put AWS access keys here. The instance role is the S3 credential.
# Do not commit .env.prod.

DVC_REMOTE=s3
AWS_DEFAULT_REGION=ap-south-1
GIT_REPO_URL=https://github.com/shreyanshhhhhhhh/MLOps_FinaL.git
MODEL_VERSION=
PORT=8000
HOST_PORT=8000
MODEL_AUTOLOAD=1
