# Copy to .env for docker compose. Do not commit .env.
# The image never contains these values.

# local uses the mounted directory. s3 uses the remote declared in .dvc/config.
DVC_REMOTE=local
# Optional absolute override if the project is not at /app.
# DVC_STORAGE_URL=/dvc-storage
DVC_STORAGE_DIR=../dvc-storage

# Leave empty to use the dvc.lock baked into the image.
# Set to a git tag or commit (model-v1, model-v2) to roll the model
# without rebuilding. GIT_REPO_URL must contain that revision.
MODEL_VERSION=
GIT_REPO_URL=file:///opt/src

PORT=8000

# Only for the s3 remote. Omit all three on an instance with an IAM role.
# AWS_ACCESS_KEY_ID=
# AWS_SECRET_ACCESS_KEY=
# AWS_DEFAULT_REGION=us-east-1
